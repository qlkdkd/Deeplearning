   "id": "5e4bb521",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "result of front propagation: q=300, f=150.0\n"
     ]
    }
   ],
   "source": [
    "x, y, z = 100, 200, 0.5\n",
    "\n",
    "q = x+y; f = q*z\n",
    "print(f'result of front propagation: q={q}, f={f}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "1ec0beb6",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "df/df=0.5, df/dy=0.5, df/dz=300\n"
     ]
    }
   ],
   "source": [
    "dfdz = q\n",
    "dfdq = z\n",
    "dqdx = 1.0\n",
    "dqdy = 1.0\n",
    "\n",
    "dfdx = dfdq * dqdx\n",
    "dfdy = dfdq * dqdy\n",
    "\n",
    "print(f'df/df={dfdx}, df/dy={dfdy}, df/dz={dfdz}')"
   ]
  }
